; eu2-ref020.uae - THE REFERENCE MACHINE of the EU2 port (user rule 2026-11-08):
; 68020, no FPU, JIT off, CPU max speed throttled -70 % (cpu_throttle is in tenths of a percent)
; = roughly a 68060 at 50-60 MHz. Every speed number in PROGRESS.md is quoted for THIS config.
; AGA chipset + a uaegfx RTG board, so the same boot tests both backends (Work:eu2.cfg gfx=aga|rtg).
; Runtime on the SSD: C:\temp\amiga_eu2 (a hardfile on I: hangs WinUAE). boot.hdf is WoW's boot060.hdf
; (68060.library + 680x0.library installed), mounted READ-ONLY.
config_window_title=EU2 PLAY (user) 68020 -70%
config_description=Amiga EU2 port - reference: 68020 no FPU, JIT off, -70%, AGA + uaegfx, 64 MB Z3

cpu_type=68020
cpu_model=68020
fpu_model=0
cpu_compatible=false
cpu_24bit_addressing=false
cpu_speed=max
cpu_throttle=-700.0
cachesize=0
chipset=aga
chipset_compatible=A4000
chipmem_size=4
fastmem_size=0
bogomem_size=0
z3mem_size=64

gfxcard_type=uaegfx
gfxcard_size=16

kickstart_rom_file=C:\temp\amiga_eu2\ROM3.1_A4000.40.70.ROM
hardfile2=ro,DH0:C:\temp\amiga_eu2\boot.hdf,32,1,2,512,0,,uae
filesystem2=rw,WORK:Work:C:\temp\amiga_eu2\work-rtgtest,-128

gfx_width_windowed=660
gfx_height_windowed=520
gfx_fullscreen_amiga=false
gfx_linemode=double
gfx_api=1
gfx_vsync=false

use_gui=no
show_leds=true
; never sound_output=none: with it audio.device writes hung (CM 01/02); "interrupts" is emulated but silent - the play guest needs exact
sound_output=interrupts
win32.inactive_nosound=false
win32.minimized_nosound=false
win32.iconified_nosound=false
win32.inactive_pause=false
win32.minimized_pause=false
win32.iconified_pause=false
magic_mouse=true
magic_mousecursor=1
win32.posx=960
win32.posy=60
win32.start_iconified=true
win32.start_not_captured=true
